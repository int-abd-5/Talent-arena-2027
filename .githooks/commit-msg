#!/bin/sh
# MTAH 2027 Possession: commit identity and attribution gate.
#
# Every commit in this repository is authored AND committed by Mozenjii, and none carries
# AI attribution. This is the mechanical half of the rule in the entry files. Never bypass it with
# --no-verify and never edit it to let a message through: a refused commit means the message or the
# identity is wrong, not the hook.
#
# Installed by the setup-software-engine skill via `git config core.hooksPath .githooks`.

expected="Mozenjii <mhbamdm@gmail.com>"
msg_file="$1"

check_ident() {
  label="$1"
  ident=$(printf '%s' "$2" | sed -E 's/ [0-9]+ [+-][0-9]{4}$//')
  if [ "$ident" != "$expected" ]; then
    echo "commit refused: $label is '$ident', expected '$expected'." >&2
    echo "Use the machine's existing git configuration: git config user.name 'Mozenjii'," >&2
    echo "git config user.email 'mhbamdm@gmail.com', and unset GIT_AUTHOR_* / GIT_COMMITTER_*." >&2
    exit 1
  fi
}

check_ident "the author" "$(git var GIT_AUTHOR_IDENT)"
check_ident "the committer" "$(git var GIT_COMMITTER_IDENT)"

# The two filenames below are removed before matching because they are ordinary files in this
# repository; a message may name them. Everything else that names an AI tool or credits a co-author
# is attribution. Refer to the entry files as "the entry files" in messages.
#
# LC_ALL=C makes grep match bytes: git runs hooks under a UTF-8 locale, where this platform's grep cannot
# match a four-byte emoji, and the robot emoji slipped through before this was added.
cleaned=$(tr '[:upper:]' '[:lower:]' <"$msg_file" | sed -e 's/claude\.md//g' -e 's/\.claude\///g')
if printf '%s\n' "$cleaned" | LC_ALL=C grep -qE 'claude|anthropic|co-authored-by|generated (with|by)|🤖'; then
  echo "commit refused: the message carries AI attribution (a tool name, a Co-Authored-By trailer," >&2
  echo "or 'generated with/by'). Commits here show Mozenjii as the only author. Rewrite the message." >&2
  exit 1
fi
exit 0
