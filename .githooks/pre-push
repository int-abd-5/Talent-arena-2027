#!/bin/sh
# MTAH 2027 Possession: refuse to push any commit that is not authored and committed by
# Mozenjii, or whose message carries AI attribution. The commit-msg hook stops these at
# commit time; this catches commits that arrived another way (rebase, cherry-pick, an import).
#
# On refusal, stop and tell Mohib. Do not rewrite history or push around the check.

zero=0000000000000000000000000000000000000000
expected="Mozenjii <mhbamdm@gmail.com>"
bad=0

while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  if [ "$remote_sha" = "$zero" ]; then
    range="$local_sha --not --remotes"
  else
    range="$remote_sha..$local_sha"
  fi
  # $range is deliberately unquoted: it is a revision expression of several words.
  for sha in $(git rev-list $range); do
    author=$(git log -1 --format='%an <%ae>' "$sha")
    committer=$(git log -1 --format='%cn <%ce>' "$sha")
    if [ "$author" != "$expected" ] || [ "$committer" != "$expected" ]; then
      echo "push refused: $sha has author '$author' / committer '$committer', expected '$expected'." >&2
      bad=1
    fi
    if git log -1 --format='%B' "$sha" | tr '[:upper:]' '[:lower:]' \
      | sed -e 's/claude\.md//g' -e 's/\.claude\///g' \
      | LC_ALL=C grep -qE 'claude|anthropic|co-authored-by|generated (with|by)|🤖'; then
      echo "push refused: $sha has a message that carries AI attribution." >&2
      bad=1
    fi
  done
done

if [ "$bad" -ne 0 ]; then
  echo "Stop and tell Mohib: every pushed commit must show Mozenjii alone." >&2
  exit 1
fi
exit 0
